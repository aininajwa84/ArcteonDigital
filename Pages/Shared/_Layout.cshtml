<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>@(ViewData["Title"] is string title ? $"{title} - Arcteon Digital" : "Arcteon Digital")</title>
  <meta name="description" content="Arcteon Digital provides AI, software customization and digital transformation to help businesses improve workflows and connect their processes.">
  <meta name="keywords" content="">

  <!-- Favicons -->
  <link href="~/assets/img/arcteon-tab-icon.png" rel="icon" type="image/png" asp-append-version="true">
  <link href="~/assets/img/arcteon-tab-icon.png" rel="apple-touch-icon" asp-append-version="true">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
  <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="~/assets/css/main.css" rel="stylesheet">
  <link href="~/assets/css/digital.css" rel="stylesheet" asp-append-version="true">
  <link href="~/assets/css/glass.css" rel="stylesheet" asp-append-version="true">
  @await RenderSectionAsync("Styles", required: false)

  <!-- =======================================================
  * Template Name: Dewi
  * Template URL: https://bootstrapmade.com/dewi-free-multi-purpose-html-template/
  * Updated: Aug 07 2024 with Bootstrap v5.3.3
  * Author: BootstrapMade.com
  * License: https://bootstrapmade.com/license/
  ======================================================== -->
</head>

<body class="@ViewData["BodyClass"]">

  <header id="header" class="header d-flex align-items-center fixed-top">
    <div class="container-fluid container-xl position-relative d-flex align-items-center">

      <a href="/" class="header-brand d-flex align-items-center me-auto">
        <img src="~/assets/img/arcteon-header-footer.png" alt="Arcteon Digital — Empowering Your Digital Transformation Journey" width="1258" height="432" asp-append-version="true">
      </a>

      <nav id="navmenu" class="navmenu">
        <ul id="primary-navigation">
          <li><a href="/#hero">Home</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href="/#services">Services</a></li>
          <li><a href="/#solutions">Solutions</a></li>
          <li><a href="/#careers">Careers</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
        <button type="button" class="mobile-nav-toggle d-xl-none bi bi-list" aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="false"></button>
      </nav>



    </div>
  </header>

  @RenderBody()

  <footer id="footer" class="footer dark-background">

    <div class="container footer-top">
      <div class="row gy-4 gx-lg-5">
        <div class="col-lg-5 col-md-12 footer-about">
          <a href="/" class="footer-brand">
            <img src="~/assets/img/arcteon-header-footer.png" alt="Arcteon Digital — Empowering Your Digital Transformation Journey" width="1258" height="432" asp-append-version="true">
          </a>
          <div class="footer-contact">
            <p><button type="button" class="address-link footer-address" data-bs-toggle="modal" data-bs-target="#locationMap">Queen’s Avenue, 8-6-3, Jalan Bayam, Cheras<br>55100 Kuala Lumpur, Malaysia <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></button></p>
            <p class="mt-3"><strong>Phone:</strong> <a href="tel:+603-92268079">+603-92268079</a></p>
            <p><strong>Email:</strong> <a href="mailto:enquiry@arcteondigital.com.my">enquiry@arcteondigital.com.my</a></p>
          </div>
          <p class="mt-2"><strong>Hours:</strong> Monday–Friday, 9.00 am–6.00 pm</p>
          <div class="social-links d-flex mt-4">
            <a href="https://www.facebook.com/profile.php?id=61572248246152" target="_blank" rel="noopener noreferrer" aria-label="Arcteon Digital on Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a>
            <a href="https://www.linkedin.com/company/arcteon-digital-sdn-bhd/" target="_blank" rel="noopener noreferrer" aria-label="Arcteon Digital on LinkedIn"><i class="bi bi-linkedin" aria-hidden="true"></i></a>
          </div>
        </div>

        <div class="col-lg-3 col-sm-6 footer-links">
          <h4>Useful Links</h4>
          <ul>
            <li><i class="bi bi-chevron-right"></i> <a href="/#hero">Home</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="/#about">About us</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="/#services">Services</a></li>
            <li><i class="bi bi-chevron-right"></i> <a href="/#solutions">Solutions</a></li>
          </ul>
        </div>

        <div class="col-lg-4 col-sm-6 footer-links">
          <h4>Our Services</h4>
          <ul>
            @foreach (var service in Dewi.Pages.IndexModel.ServiceCatalogue)
            {
                <li><i class="bi bi-chevron-right"></i> <a asp-page="/Expertise" asp-route-service="@service.Key">@service.Title</a></li>
            }
          </ul>
        </div>

        @* <div class="col-lg-4 col-md-12 footer-newsletter">
          <h4>Our Newsletter</h4>
          <p>Subscribe to our newsletter and receive the latest news about our products and services!</p>
          <form action="/forms/newsletter" method="post" class="php-email-form">
            @Html.AntiForgeryToken()
            <div class="newsletter-form"><input type="email" name="email" aria-label="Newsletter email address" required><input type="submit" value="Subscribe"></div>
            <div class="loading">Loading</div>
            <div class="error-message"></div>
            <div class="sent-message">Your subscription request has been saved locally. Thank you!</div>
          </form>
        </div> *@


      </div>
    </div>

    <div class="container copyright footer-bottom mt-4">
      <p>© 2026 <strong class="sitename">Arcteon Digital Sdn Bhd</strong>. All rights reserved.</p>
      <div class="footer-md-badge">
        <span>Awarded Malaysia Digital Status</span>
        <img src="~/assets/img/malaysia-digital-logo.png" alt="Malaysia Digital" width="233" height="118" loading="lazy" asp-append-version="true">
      </div>
    </div>

  </footer>

  <div class="modal fade" id="locationMap" tabindex="-1" aria-labelledby="locationMapTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title fs-5" id="locationMapTitle">Find Arcteon Digital</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close map"></button></div>
      <div class="modal-body"><p>Queen’s Avenue, 8-6-3, Jalan Bayam, Cheras, 55100 Kuala Lumpur, Malaysia</p>
        <iframe title="Map of Arcteon Digital at Queen’s Avenue, Cheras" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3983.866412529625!2d101.7212046!3d3.1299916!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31cc3771dc68086d:0xebfadf7c905c19df!2sArcteon+Digital+Sdn+Bhd!5e0!3m2!1sen!2smy!4v1738749368227!5m2!1sen!2smy" width="1024" height="350" style="border:0;width:100%" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen="true"></iframe>
      </div><div class="modal-footer"><a class="digital-btn" href="https://www.google.com/maps/dir/?api=1&amp;destination=Arcteon%20Digital%20Sdn%20Bhd%20Queen%27s%20Avenue%208-6-3%20Jalan%20Bayam%20Cheras%2055100%20Kuala%20Lumpur" target="_blank" rel="noopener noreferrer">Get directions <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a></div>
    </div></div>
  </div>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader"></div>

  <!-- Vendor JS Files -->
  <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="~/assets/vendor/php-email-form/validate.js" asp-append-version="true"></script>
  <script src="~/assets/vendor/aos/aos.js"></script>
  <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
  <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>
  <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
  <script src="~/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
  <script src="~/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>

  <!-- Main JS File -->
  <script src="~/assets/js/main.js" asp-append-version="true"></script>
  <script src="~/assets/js/careers.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
