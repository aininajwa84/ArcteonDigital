<div class="modal fade" id="careerApplication" tabindex="-1" aria-labelledby="careerApplicationTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg"><div class="modal-content">
        <div class="modal-header"><div><p class="eyebrow">CAREER APPLICATION</p><h2 class="modal-title" id="careerApplicationTitle">General Interest</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close application"></button></div>
        <div class="modal-body contact">
            <p id="application-role-context" class="application-role-context"></p>
            <form action="/forms/applications" method="post" enctype="multipart/form-data" class="php-email-form" id="career-application-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="role" id="application-role" value="General Interest">
                <div class="row gy-3">
                    <div class="col-sm-6"><label for="application-name" class="form-label">Full name *</label><input id="application-name" class="form-control" name="name" autocomplete="name" maxlength="200" required></div>
                    <div class="col-sm-6"><label for="application-email" class="form-label">Email address *</label><input id="application-email" class="form-control" type="email" name="email" autocomplete="email" maxlength="254" required></div>
                    <div class="col-sm-6"><label for="application-phone" class="form-label">Phone number *</label><input id="application-phone" class="form-control" type="tel" name="phone" autocomplete="tel" maxlength="40" required></div>
                    <div class="col-sm-6" id="application-interest-options" hidden>
                        <label for="application-interest" class="form-label">Application type</label>
                        <select id="application-interest" class="form-select" name="interest" disabled>
                            <option>Internship</option>
                            <option>Full-time</option>
                        </select>
                    </div>
                    <div class="col-sm-6" id="application-general-interest">
                        <label for="application-general-type" class="form-label">Application type</label>
                        <input id="application-general-type" class="form-control" value="@CareerRoles.GeneralInterest" readonly>
                    </div>
                    <div class="col-12"><label for="application-university" class="form-label">University / organization (optional)</label><input id="application-university" class="form-control" name="organization" maxlength="200"></div>
                    <fieldset class="col-12" id="internship-dates" disabled hidden>
                        <legend class="visually-hidden">Internship availability</legend>
                        <div class="row gy-3">
                            <div class="col-sm-6">
                                <label for="application-date" class="form-label">Available start date (optional)</label>
                                <input id="application-date" class="form-control" type="date" name="startDate">
                            </div>
                            <div class="col-sm-6">
                                <label for="application-end-date" class="form-label">Internship end date (optional)</label>
                                <input id="application-end-date" class="form-control" type="date" name="endDate">
                            </div>
                        </div>
                    </fieldset>
                    <div class="col-12">
                        <label for="application-resume" class="form-label">Résumé / CV *</label>
                        <input id="application-resume" class="form-control" type="file" name="resume" accept=".pdf,.doc,.docx" aria-describedby="resume-guidance" required>
                        <small id="resume-guidance">PDF, DOC or DOCX. Maximum 5 MB.</small>
                    </div>
                    <div class="col-12">
                        <label for="application-supporting-documents" class="form-label">Supporting documents (optional)</label>
                        <input id="application-supporting-documents" class="form-control" type="file" name="supportingDocuments" accept=".pdf,.doc,.docx" aria-describedby="supporting-documents-guidance" multiple>
                        <small id="supporting-documents-guidance">Choose up to 3 related documents, such as a cover letter or certificates. PDF, DOC or DOCX, up to 5 MB each and 15 MB total including your résumé. Avoid uploading identity documents or other sensitive records.</small>
                    </div>
                    <div class="col-12"><label for="application-message" class="form-label">Cover note (optional)</label><textarea id="application-message" class="form-control" name="message" rows="3" maxlength="10000" placeholder="Tell us about your background and interests"></textarea></div>
                    <div class="col-12"><label class="application-confirm"><input type="checkbox" name="consent" value="true" required> <span>I agree to send my application and attachments to Arcteon Digital’s HR team for recruitment review.</span></label></div>
                    <div class="col-12"><div class="loading" role="status">Sending your application…</div><div class="error-message" role="alert"></div><div class="sent-message" role="status">Your application and attachments have been sent to our HR team.</div><button type="submit">Send Application <i class="bi bi-arrow-up-right" aria-hidden="true"></i></button></div>
                </div>
            </form>
        </div>
    </div></div>
</div>
