@model IReadOnlyList<Dewi.Pages.BusinessSolution>
@foreach (var solution in Model)
{
    <a href="@solution.Href" class="solution-card" target="@(solution.OpensExternalSite ? "_blank" : null)" rel="@(solution.OpensExternalSite ? "noopener noreferrer" : null)">
        <div class="product-brand-panel product-panel-@solution.Key @(solution.LogoFile is not null ? "has-standalone-logo" : "")">
            @if (solution.LogoFile is { } logoFile)
            {
                <img class="product-logo-image product-logo-@solution.Key" src="~/assets/img/products/@logoFile" alt="@solution.LogoAlt" loading="lazy" asp-append-version="true">
            }
            else if (solution.Key == "adai")
            {
                <span class="product-brand product-adai" role="img" aria-label="@solution.LogoAlt"><span>AD<span class="product-adai-dot">.</span>AI</span></span>
            }
            else
            {
                <span class="product-brand @solution.LogoClass" role="img" aria-label="@solution.LogoAlt"></span>
            }
        </div>
        <div class="product-card-body"><span class="solution-category">@solution.Category</span><h3>@solution.Title</h3><p>@solution.Description</p><span class="solution-link">@solution.CallToAction <span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></span></span></div>
    </a>
}