@page "/services/{service}"
@model Dewi.Pages.ExpertiseModel
@{
    var current = Model.CurrentService;
    ViewData["Title"] = current.Title;
    ViewData["Description"] = $"{current.Description} {current.Detail}";
    ViewData["BodyClass"] = "service-details-page";
}
@functions {
    static string ToJsonLd(object value) => System.Text.Json.JsonSerializer.Serialize(value,
        new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping });
}
@section StructuredData {
    @{
        var siteUrl = (HttpContext.RequestServices.GetRequiredService<IConfiguration>()["Site:BaseUrl"] ?? $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}").TrimEnd('/');
        var service = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Service",
            ["name"] = current.Title,
            ["description"] = current.Description,
            ["areaServed"] = "MY",
            ["provider"] = new Dictionary<string, string> { ["@id"] = siteUrl + "/#organization" }
        };
        var breadcrumbs = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new object[]
            {
                new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = siteUrl + "/" },
                new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = current.Title }
            }
        };
    }
    <script type="application/ld+json">@Html.Raw(ToJsonLd(service))</script>
    <script type="application/ld+json">@Html.Raw(ToJsonLd(breadcrumbs))</script>
    @if (Model.Faqs.Count > 0)
    {
        var faqPage = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = Model.Faqs.Select(f => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = f.Question,
                ["acceptedAnswer"] = new Dictionary<string, string> { ["@type"] = "Answer", ["text"] = f.Answer }
            }).ToArray()
        };
        <script type="application/ld+json">@Html.Raw(ToJsonLd(faqPage))</script>
    }
}
<main class="main product-details-refined">
    <div class="page-title dark-background" style="background-image: url('/assets/img/digital-business-workflow.jpg')">
        <div class="container position-relative">
            <p class="eyebrow">OUR SERVICES / ARCTEON DIGITAL</p>
            <h1>@current.Title</h1>
            <p>@current.Description</p>
            <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/#services">Services</a></li><li class="current">@current.Title</li></ol></nav>
        </div>
    </div>
    <section class="section solution-detail">
        <div class="container"><div class="row gy-5 gx-lg-5">
            <aside class="col-lg-4">
                <div class="product-detail-sidebar">
                    <nav class="product-sidebar-nav" aria-labelledby="service-sidebar-title">
                        <h2 id="service-sidebar-title"><span class="d-none d-lg-inline">Our Services</span><button class="product-sidebar-toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#service-sidebar-links" aria-expanded="false" aria-controls="service-sidebar-links">Browse our services <i class="bi bi-chevron-down" aria-hidden="true"></i></button></h2>
                        <div id="service-sidebar-links" class="collapse d-lg-block"><ul>
                        @foreach (var service in Model.Services)
                        {
                            var isCurrent = service.Key == current.Key;
                            <li><a asp-page="/Expertise" asp-route-service="@service.Key" class="@(isCurrent ? "active" : null)" aria-current="@(isCurrent ? "page" : null)"><i class="bi @service.Icon" aria-hidden="true"></i><span>@service.Title</span></a></li>
                        }
                        </ul></div>
                    </nav>
                    <div class="product-sidebar-contact">
                        <i class="bi bi-headset" aria-hidden="true"></i>
                        <h2>Have a question?</h2>
                        <p>Talk to us about your business requirements.</p>
                        <a href="tel:+60392268079">+603 9226 8079</a>
                        <a href="mailto:enquiry@arcteondigital.com.my">enquiry@arcteondigital.com.my</a>
                    </div>
                </div>
            </aside>
            <div class="col-lg-8 product-detail-content">
                <p class="eyebrow">HOW WE CAN HELP</p>
                <h2 class="product-content-title">@current.Title</h2>
                <p class="product-content-intro">@current.Detail</p>
                @if (Model.Example is { } example)
                {
                    <div class="service-example">
                        <h3>@example.Title</h3>
                        <p>@example.Description</p>
                    </div>
                }
                <dl class="product-feature-list">
                @foreach (var area in Model.Areas)
                {
                    <div><dt><i class="bi bi-check2-circle" aria-hidden="true"></i>@area.Title</dt><dd>@area.Description</dd></div>
                }
                </dl>
                @if (current.Key == "artificial-intelligence")
                {
                    var brochureUrl = Url.Content("~/assets/brochures/ad-ai-brochure.png");
                    <section class="product-brochure" aria-labelledby="ad-ai-brochure-title">
                        <div class="product-brochure-heading">
                            <h3 id="ad-ai-brochure-title">Product brochure</h3>
                        </div>
                        <p>See how AD.AI helps audit teams analyse data, find information and prepare reports.</p>
                        <a href="@brochureUrl" class="product-brochure-preview glightbox" target="_blank" rel="noopener" aria-label="Enlarge the AD.AI brochure">
                            <img src="@brochureUrl" alt="AD.AI brochure showing the solution overview, how it works and key benefits" width="1264" height="841" loading="lazy" asp-append-version="true">
                        </a>
                        <partial name="_BrochureActions" model="(brochureUrl, (string?)null)" />
                    </section>
                }
                @if (Model.Faqs.Count > 0)
                {
                    <section class="product-faq" aria-labelledby="service-faq-title">
                        <h2 id="service-faq-title">Frequently asked questions</h2>
                        @foreach (var faq in Model.Faqs)
                        {
                            <details><summary>@faq.Question</summary><p>@faq.Answer</p></details>
                        }
                    </section>
                }
                <div class="product-enquiry">
                    <p>Tell us what you want to improve. We’ll work with you to clarify requirements, review your current systems and agree on a practical next step.</p>
                    <a href="/#contact-project" class="digital-btn">Discuss your project <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                    <p class="product-scope-note">Scope, integrations and delivery timelines are confirmed during discovery.</p>
                </div>
            </div>
        </div></div>
    </section>
</main>
