@page "/service-details"
@model Dewi.Pages.ServiceDetailsModel
@{
    ViewData["Title"] = Model.Solution?.Title ?? "Our expertise";
    ViewData["BodyClass"] = "service-details-page";
    var hasSolution = Model.Solution is not null;
    var logoOnlyBanner = Model.Solution?.Key is "clinic" or "queue" or "nexus";
    var detailContent = Model.DetailContent;
    var bannerImage = hasSolution ? Url.Content($"~/assets/img/{Model.DetailPhoto.File}") : null;
}
<main class="main @(hasSolution ? "product-details-refined" : "")">
    <div class="page-title dark-background" style="@(hasSolution ? $"background-image: url('{bannerImage}')" : null)">
        <div class="container position-relative">
            <p class="eyebrow">@(hasSolution ? $"{(Model.Solution!.IsClientSolution ? "CLIENT SOLUTION" : "OUR PRODUCT")} / {Model.Solution.Category}" : "BUSINESS SOLUTIONS / ARCTEON DIGITAL")</p>
            @if (Model.Solution is { } bannerProduct)
            {
                <div class="product-banner-brand @(bannerProduct.Key == "nexus" ? "product-banner-brand-stacked" : null)">
                    @if (bannerProduct.BannerLogoFile is { } logoFile)
                    {
                        <img class="product-logo-image product-banner-image product-logo-@bannerProduct.Key" src="~/assets/img/products/@logoFile" alt="@bannerProduct.LogoAlt" asp-append-version="true">
                    }
                    else
                    {
                        <span class="product-brand @bannerProduct.LogoClass product-banner-logo" role="img" aria-label="@bannerProduct.LogoAlt"></span>
                    }
                    <h1 class="@(logoOnlyBanner ? "visually-hidden" : null)">@bannerProduct.Title</h1>
                    @if (bannerProduct.Key == "nexus")
                    {
                        <span class="product-banner-subtitle"><i class="bi bi-stars" aria-hidden="true"></i> Powered by AD.AI</span>
                        <span class="product-banner-ai-description">AI-assisted document search helps you find information faster.</span>
                    }
                </div>
            }
            else
            {
                <h1>@ViewData["Title"]</h1>
            }
            <p>@(Model.Solution?.Description ?? "Connected technology, shaped around your business.")</p>
            @if (Model.Solution?.Key == "hr")
            {
                <a href="#workvibes-downloads" class="inline-link mb-3">Downloads &amp; guides <i class="bi bi-arrow-down" aria-hidden="true"></i></a>
            }
            <nav class="breadcrumbs" aria-label="Breadcrumb">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li><a href="/#solutions">Solutions</a></li>
                    @if (!logoOnlyBanner)
                    {
                        <li class="current" aria-current="page">@ViewData["Title"]</li>
                    }
                </ol>
            </nav>
        </div>
    </div>
    <section class="section solution-detail"><div class="container"><div class="row gy-5 gx-lg-5">
        <aside class="col-lg-4">
            <div class="product-detail-sidebar">
                <nav class="product-sidebar-nav" aria-labelledby="product-sidebar-title">
                    <h2 id="product-sidebar-title"><span class="d-none d-lg-inline">Our Products</span><button class="product-sidebar-toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#product-sidebar-links" aria-expanded="false" aria-controls="product-sidebar-links">Browse our products <i class="bi bi-chevron-down" aria-hidden="true"></i></button></h2>
                    <div id="product-sidebar-links" class="collapse d-lg-block"><ul>
                    @foreach (var product in Model.Products)
                    {
                        var isCurrent = Model.Solution?.Key == product.Key;
                        <li><a asp-page="/ServiceDetails" asp-route-solution="@product.Key" class="@(isCurrent ? "active" : null)" aria-current="@(isCurrent ? "page" : null)"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i><span>@product.Title</span></a></li>
                    }
                    </ul></div>
                </nav>
                <div class="product-sidebar-contact">
                    <i class="bi bi-headset" aria-hidden="true"></i>
                    <h2>Have a question?</h2>
                    <p>Let’s discuss the right solution for your business.</p>
                    <a href="tel:+603-92268079">+603-92268079</a>
                    <a href="mailto:enquiry@arcteondigital.com.my">enquiry@arcteondigital.com.my</a>
                </div>
            </div>
        </aside>
        <div class="col-lg-8 product-detail-content">
        @if (Model.Solution is { } selected)
        {
            var intro = selected switch
            {
                { Key: "nexus" } => "Powered by AD.AI, Arcteon Nexus helps your team find information in digitised records without sorting through paper files.",
                { IsClientSolution: true } => "Developed for a client’s operational requirements. Explore the project areas below and talk to us about a similar workflow for your business.",
                _ => "Explore the core areas below, then talk to us about the way your team works."
            };
            <p class="eyebrow">@(selected.IsClientSolution ? "CLIENT PROJECT / HOW IT HELPS" : "HOW IT HELPS")</p>
            <h2 class="product-content-title">@detailContent.Heading</h2>
            <p class="product-content-intro">@intro</p>
            <dl class="product-feature-list">
            @for (var index = 0; index < selected.Features.Length; index++)
            {
                <div><dt><i class="bi bi-check2-circle" aria-hidden="true"></i>@selected.Features[index]</dt><dd>@detailContent.FeatureDescriptions[index]</dd></div>
            }
            </dl>
        }
        else
        {
            <p>Explore our three core services: AI, Software Customization and Digital Transformation. We help you identify useful AI applications, adapt software to your workflows and connect your business processes with digital tools.</p>
            <a href="/#services" class="inline-link">Explore all services <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        }
        @if (Model.Solution?.Key == "assets")
        {
            <partial name="_SepPresentation" model="Dewi.Pages.SepPresentation.Viewer" />
        }
        else if (Model.HasNexusBrochure)
        {
            <div id="product-brochures" class="product-brochure" role="region" aria-labelledby="nexus-brochure-title">
                <div class="product-brochure-heading">
                    <h2 id="nexus-brochure-title">Arcteon Nexus brochure</h2>
                </div>
                <p>Explore the five modules and see how to connect them as your business grows.</p>
                <a href="~/assets/brochures/nexus/arcteon-nexus-brochure.webp" class="product-brochure-preview glightbox" data-title="Arcteon Nexus brochure" target="_blank" rel="noopener" aria-label="View the Arcteon Nexus brochure full size">
                    <img src="~/assets/brochures/nexus/arcteon-nexus-brochure.webp" alt="Arcteon Nexus brochure covering five business modules and how to get started" width="1800" height="1200" loading="lazy" asp-append-version="true">
                </a>
                <partial name="_BrochureActions" model='(Url.Content("~/assets/brochures/nexus/arcteon-nexus-brochure.pdf"), (string?)null)' />
            </div>
        }
        else if (Model.Brochure is { } brochure)
        {
            var previewUrl = Url.Content($"~/assets/brochures/{brochure.Preview}");
            var documentUrl = Url.Content($"~/assets/brochures/{brochure.Pdf ?? brochure.Preview}");
            <section class="product-brochure" aria-labelledby="product-brochure-title">
                <div class="product-brochure-heading"><h2 id="product-brochure-title">Product brochure</h2></div>
                <a href="@previewUrl" class="product-brochure-preview glightbox" data-gallery="product-brochure" data-title="@brochure.Title" target="_blank" rel="noopener" aria-label="View @brochure.Title brochure full size">
                    <img src="@previewUrl" alt="@brochure.Title brochure with product features" width="@brochure.Width" height="@brochure.Height" loading="lazy" asp-append-version="true">
                </a>
                <partial name="_BrochureActions" model="(documentUrl, (string?)null)" />
            </section>
        }
        @if (Model.Solution?.Key == "hr")
        {
            <section id="workvibes-downloads" class="product-brochure" aria-labelledby="workvibes-downloads-title">
                <div class="product-brochure-heading">
                    <h2 id="workvibes-downloads-title">Downloads &amp; user guides</h2>
                </div>
                <dl class="product-feature-list">
                    <div>
                        <dt><i class="bi bi-phone" aria-hidden="true"></i> Android app</dt>
                        <dd>Download the WorkVibes installer on your Android device. After installing, sign in with the account provided by your organisation.</dd>
                        <dd class="product-brochure-actions">
                            <a href="~/assets/downloads/workvibes/workvibes-android.apk" download>Download Android APK (82 MB) <i class="bi bi-download" aria-hidden="true"></i></a>
                        </dd>
                    </div>
                    <div>
                        <dt><i class="bi bi-book" aria-hidden="true"></i> Mobile app user guide</dt>
                        <dd>Sign in with the account provided by your organisation. From Home, use <strong>Time In/Out</strong> to record attendance, <strong>Leave</strong> to request time off, and <strong>Expenses</strong> to submit claims.</dd>
                        <dd class="product-brochure-actions">
                            <a href="~/assets/guides/workvibes/workvibes-mobile-app-user-guide.pdf" target="_blank" rel="noopener" aria-label="View the mobile app user guide in a new tab">View in new tab <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                            <a href="~/assets/guides/workvibes/workvibes-mobile-app-user-guide.pdf" download aria-label="Download the mobile app user guide PDF">Download PDF <i class="bi bi-download" aria-hidden="true"></i></a>
                        </dd>
                    </div>
                    <div>
                        <dt><i class="bi bi-display" aria-hidden="true"></i> Web portal user guide</dt>
                        <dd>Open the portal link provided by your organisation and sign in with your registered email address. Employees can review attendance, leave, expenses and payslips. Administrators can manage employee records and export timesheets.</dd>
                        <dd class="product-brochure-actions">
                            <a href="~/assets/guides/workvibes/workvibes-web-portal-user-guide.pdf" target="_blank" rel="noopener" aria-label="View the web portal user guide in a new tab">View in new tab <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                            <a href="~/assets/guides/workvibes/workvibes-web-portal-user-guide.pdf" download aria-label="Download the web portal user guide PDF">Download PDF <i class="bi bi-download" aria-hidden="true"></i></a>
                        </dd>
                    </div>
                </dl>
            </section>
        }
        @if (hasSolution)
        {
            <div class="product-enquiry"><p>@detailContent.Enquiry</p><a href="/#contact-project" class="digital-btn">@(Model.Solution!.IsClientSolution ? "Discuss a similar project" : $"Enquire about {Model.Solution.Title}") <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a><p class="product-scope-note">Features, integrations and delivery timelines are confirmed during discovery.</p></div>
        }
        else
        {
            <p>We’ll work with you to agree on requirements, integrations, access controls and a practical delivery plan. Features and timelines are confirmed during discovery.</p>
            <a href="/#contact" class="digital-btn">Discuss this solution <i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
        }
        </div>
    </div></div></section>
</main>

@section Styles {
    @if (Model.Solution?.Key == "assets")
    {
        <link href="~/assets/css/sep-presentation.css" rel="stylesheet" asp-append-version="true">
    }
}
@section Scripts {
    @if (Model.Solution?.Key == "assets")
    {
        <script src="~/assets/js/sep-presentation.js" asp-append-version="true"></script>
    }
}
